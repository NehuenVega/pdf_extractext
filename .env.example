# Variables opcionales para docker compose. Todas tienen valor por defecto en
# docker-compose.yml: este archivo solo hace falta para probar variantes.
# Uso: copiarlo como .env, cambiar lo que haga falta y volver a levantar.
# (La API también lee estas variables si se corre sin Docker: ver App/core/config.py.)

# --- Réplicas de la API ------------------------------------------------------
# Cantidad de réplicas (máximo 5 según la consigna).
REPLICAS=5
# Procesos que extraen PDFs dentro de cada réplica (1 CPU por réplica → 1).
EXTRACTION_WORKERS=1
# Pedidos que pueden esperar dentro de una réplica y por cuánto tiempo.
MAX_QUEUE_SIZE=8
QUEUE_TIMEOUT_SECONDS=25
# Tamaño máximo de PDF aceptado y tiempo máximo para recibirlo.
MAX_FILE_SIZE_MB=32
UPLOAD_TIMEOUT_SECONDS=15
# DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO

# --- Balanceador (HAProxy) -------------------------------------------------
# Pedidos simultáneos que se le mandan a cada réplica; el resto espera en la
# cola central del balanceador.
HAPROXY_SERVER_MAXCONN=1
# Espera máxima en la cola central antes de responder 503.
HAPROXY_QUEUE_TIMEOUT=25s
# Largo de cola a partir del cual se rechaza en el momento con 503.
HAPROXY_MAX_QUEUE=1000
# PDFs de menos de estos bytes salen primero de la cola (0 = FIFO pura).
HAPROXY_SMALL_PDF_BYTES=1048576
